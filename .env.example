# ==============================================================================
# DOCODO.IN — PRODUCTION ENVIRONMENT CONFIGURATION SPECIFICATION (.env.example)
# Categorized by Scope, Security, and Production Requirement
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. DATABASE & POSTGRESQL (SERVER ONLY | PRODUCTION REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# Supabase pooled or direct PostgreSQL connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"

# Supabase postgREST fallback credentials
# PUBLIC: Client-safe publishable URL and Anon key
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_[KEY]"

# ──────────────────────────────────────────────────────────────────────────────
# 2. AUTHENTICATION & SESSIONS (SERVER ONLY | PRODUCTION REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# Minimum 32 characters random secret for NextAuth JWT session encryption
NEXTAUTH_SECRET="your-32-char-random-nextauth-secret-string"
AUTH_SECRET="your-32-char-random-nextauth-secret-string"

# Canonical production URLs
# SERVER ONLY: NextAuth internal redirect base URL
NEXTAUTH_URL="https://docodo.in"
# PUBLIC: Client-side navigation and asset base URL
NEXT_PUBLIC_APP_URL="https://docodo.in"

# ──────────────────────────────────────────────────────────────────────────────
# 3. RAZORPAY PAYMENT GATEWAY (SERVER ONLY + PUBLIC KEY | PRODUCTION REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# PUBLIC: Razorpay Key ID inlined into the client-side checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_[KEY_ID]"

# SERVER ONLY: Key ID and secret for server-side order creation and HMAC signature verification
RAZORPAY_KEY_ID="rzp_live_[KEY_ID]"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# SERVER ONLY: Webhook secret configured in Razorpay Dashboard to sign order.paid webhooks
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ──────────────────────────────────────────────────────────────────────────────
# 4. GOOGLE OAUTH 2.0 (SERVER ONLY | OPTIONAL)
# ──────────────────────────────────────────────────────────────────────────────
# Required only if Google One-Click Login is enabled
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ──────────────────────────────────────────────────────────────────────────────
# 5. TRANSACTIONAL NOTIFICATIONS (SERVER ONLY | PRODUCTION REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# Resend API key for automated booking confirmations and password reset emails
RESEND_API_KEY="re_your_resend_api_key"

# ──────────────────────────────────────────────────────────────────────────────
# 6. AI ENGINE & CONTENT REPURPOSING (SERVER ONLY | PRODUCTION RECOMMENDED)
# ──────────────────────────────────────────────────────────────────────────────
# Google Gemini API key (recommended: gemini-1.5-flash for WhatsApp assistant & marketing copy)
GEMINI_API_KEY="AIzaSy_your_gemini_api_key"

# Optional multi-provider cascade keys (Groq LLaMA 3.3, Cerebras, OpenRouter)
GROQ_API_KEY="gsk_your_groq_api_key"
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"

# ──────────────────────────────────────────────────────────────────────────────
# 7. AUTOMATED 24-HR REMINDERS CRON (SERVER ONLY | PRODUCTION REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# Secret Bearer token sent by Vercel Cron to authorize /api/cron/reminders
CRON_SECRET="your-cron-secret-token"

# ──────────────────────────────────────────────────────────────────────────────
# 8. FOUNDER SUPERADMIN CONTROL CENTER (SERVER ONLY | PRODUCTION REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# Secret and password protecting the /founder portal
FOUNDER_SECRET="your-secure-founder-secret-key-32-chars-minimum"
FOUNDER_PASSWORD="your-strong-founder-password"

# ──────────────────────────────────────────────────────────────────────────────
# 9. META WHATSAPP CLOUD API (SERVER ONLY | OPTIONAL)
# ──────────────────────────────────────────────────────────────────────────────
# Required only if direct Meta Graph API messaging is used instead of wa.me links
WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_cloud_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_VERIFY_TOKEN="docodo_wa_verify_secret"
