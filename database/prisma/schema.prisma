generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTHENTICATION & ACCESS CONTROL ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for credentials login
  role          String    @default("OWNER") // OWNER | MANAGER | STAFF
  plan          String    @default("PILOT") // PILOT | STARTER | GROWTH | CONCIERGE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  businesses    Business[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── CORE BUSINESS METADATA ──────────────────────────────────────────────────

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  industry    String
  tagline     String?
  description String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  website     String?
  logo        String?  // Cloud storage URL
  coverImage  String?  // Cloud storage URL
  
  // Theme Design Tokens
  style       String   @default("modern")
  primaryColor String  @default("#C8F135")
  accentColor  String  @default("#00FFAA")
  fontHeading  String  @default("Unbounded")
  fontBody     String  @default("DM Sans")
  darkMode     Boolean @default(true)
  
  // Social Connectivity
  instagram   String?
  facebook    String?
  youtube     String?
  twitter     String?
  whatsapp    String?
  
  // Platform Configuration
  isPublished Boolean  @default(true)
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  
  // SEO Optimization
  seoTitle    String?
  seoDesc     String?
  websiteConfig String? @default("{\"hero\":true,\"services\":true,\"about\":true,\"gallery\":true,\"testimonials\":true,\"faq\":false,\"contact\":true,\"booking_cta\":true}")
  
  // Onboarding & Discovery Telemetry
  onboardingStep     Int       @default(4)
  onboardingComplete Boolean   @default(true)
  onboardingStartedAt DateTime?
  onboardingCompletedAt DateTime?
  setupTimeMinutes   Int?
  discoveryQuery     String?
  discoveredProfile  String?
  activationScore    Int       @default(20)
  activatedAt        DateTime?
  timeToFirstBooking Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  workingHours WorkingHours[]
  services     Service[]
  staff        Staff[]
  bookings     Booking[]
  customers    Customer[]
  enquiries    Enquiry[]
  aiContents   AIContent[]
  whatsappLogs WhatsAppLog[]
  codLedgers   CODLedger[]
  ndrDisputes  NDRDispute[]
  knowledgeBases KnowledgeBase[]
  conversations  Conversation[]

  // Real Subscriptions, Entitlements & Provisioning
  subscriptions       Subscription[]
  entitlements        BusinessEntitlement[]
  usageRecords        UsageRecord[]
  conciergeOrders     ConciergeOrder[]
}

// ─── SUBSCRIPTIONS & ENTITLEMENTS LEDGER ─────────────────────────────────────

model Subscription {
  id                     String    @id @default(cuid())
  businessId             String
  planId                 String    // pilot | starter | growth | setup-service
  status                 String    @default("ACTIVE") // TRIAL | ACTIVE | PAST_DUE | CANCELLED | EXPIRED | PAYMENT_FAILED
  provider               String    @default("SYSTEM") // RAZORPAY | SYSTEM | CONCIERGE
  providerSubscriptionId String?
  currentPeriodStart     DateTime  @default(now())
  currentPeriodEnd       DateTime
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

model Plan {
  id              String        @id
  name            String
  price           Float
  billingInterval String        // FOREVER | MONTHLY | ONE_TIME
  active          Boolean       @default(true)
  features        PlanFeature[]
}

model PlanFeature {
  id         String  @id @default(cuid())
  planId     String
  featureKey String
  value      String  // "true", "false", "50", "UNLIMITED"

  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model BusinessEntitlement {
  id         String    @id @default(cuid())
  businessId String
  featureKey String
  value      String
  source     String    @default("PLAN") // PLAN | CONCIERGE | MANUAL_OVERRIDE | TRIAL
  startsAt   DateTime  @default(now())
  expiresAt  DateTime?

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureKey])
  @@index([businessId])
}

model UsageRecord {
  id          String   @id @default(cuid())
  businessId  String
  metric      String   // BOOKINGS_COUNT
  periodStart DateTime
  periodEnd   DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, metric, periodStart, periodEnd])
  @@index([businessId, metric])
}

model ConciergeOrder {
  id                 String    @id @default(cuid())
  businessId         String
  status             String    @default("PAYMENT_RECEIVED") // PAYMENT_RECEIVED | ONBOARDING_PENDING | SPECIALIST_ASSIGNED | BUSINESS_DETAILS_COLLECTED | SERVICES_UPLOADED | HOURS_CONFIGURED | BOOKING_PAGE_READY | QR_READY | WHATSAPP_OPTIMIZED | TRAINING_COMPLETED | COMPLETED
  assignedSpecialist String?   @default("Ameya Kshirsagar")
  onboardingStatus   String?   @default("SPECIALIST_ASSIGNED")
  purchasedAt        DateTime  @default(now())
  growthStart        DateTime?
  growthEnd          DateTime?
  razorpayPaymentId  String?
  razorpayOrderId    String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  payload     String   // JSON payload string
  status      String   @default("PROCESSED") // PROCESSED | FAILED
  processedAt DateTime @default(now())

  @@index([eventId])
}

// ─── CATALOG & HUMAN RESOURCES ───────────────────────────────────────────────

model WorkingHours {
  id         String   @id @default(cuid())
  businessId String
  day        String   // MON | TUE | WED | THU | FRI | SAT | SUN
  isOpen     Boolean  @default(true)
  openTime   String   @default("09:00")
  closeTime  String   @default("19:00")
  breakStart String?
  breakEnd   String?
  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  duration    Int      @default(60)
  price       Float    @default(999)
  currency    String   @default("INR")
  isActive    Boolean  @default(true)
  color       String?  
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([businessId])
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  name       String
  role       String?  @default("Specialist")
  email      String?
  phone      String?
  avatar     String?
  bio        String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([businessId])
}

// ─── BOOKINGS & TRANSACTION LEDGER ───────────────────────────────────────────

model Booking {
  id           String   @id @default(cuid())
  businessId   String
  serviceId    String?
  staffId      String?
  customerId   String?
  
  customerName  String
  customerEmail String?
  customerPhone String
  
  date          String   // YYYY-MM-DD
  startTime     String   // HH:MM
  endTime       String   
  duration      Int      
  
  status        String   @default("CONFIRMED") // CONFIRMED | PENDING | COMPLETED | CANCELLED | NO_SHOW | NDR_HOLD
  notes         String?
  internalNotes String?
  price         Float    @default(0)
  paidAmount    Float    @default(0)
  paymentStatus String   @default("UNPAID") // UNPAID | PARTIAL | PAID | COD_VERIFYING
  paymentMethod String?  @default("UPI")
  
  reminderSent  Boolean  @default(false)
  reviewSent    Boolean  @default(false)
  
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service       Service?  @relation(fields: [serviceId], references: [id])
  staff         Staff?    @relation(fields: [staffId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  ndrDispute    NDRDispute?

  @@index([businessId, date, status])
  @@index([customerId])
  @@index([businessId, createdAt])
}

// ─── CRM (CUSTOMER RELATIONSHIP MANAGEMENT) ──────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  email         String?
  phone         String
  avatar        String?
  notes         String?
  tags          String?
  lifetimeValue Float    @default(0)
  visitCount    Int      @default(0)
  source        String?  @default("WHATSAPP")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@unique([businessId, phone])
  @@index([businessId])
}

// ─── AI ENGINE STORAGE & HISTORY ─────────────────────────────────────────────

model AIContent {
  id         String   @id @default(cuid())
  businessId String
  type       String
  prompt     String?
  content    String
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── WHATSAPP AUTOMATION ENGINE LOGS ─────────────────────────────────────────

model WhatsAppLog {
  id          String   @id @default(cuid())
  businessId  String
  recipient   String
  messageType String
  content     String
  status      String   @default("DELIVERED")
  externalId  String?
  timestamp   DateTime @default(now())
  
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── CASH ON DELIVERY & PAYMENT RECONCILIATION LEDGER ────────────────────────

model CODLedger {
  id            String   @id @default(cuid())
  businessId    String
  bookingId     String?  
  amount        Float
  status        String   @default("PENDING_COLLECTION")
  collectorName String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── NON-DELIVERY REPORT (NDR) & DISPUTE DEFENSE SYSTEM ──────────────────────

model NDRDispute {
  id            String   @id @default(cuid())
  businessId    String
  bookingId     String   @unique
  reason        String
  aiResolution  String?
  status        String   @default("UNDER_AI_REVIEW")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── CUSTOMER ENQUIRY & LEAD CAPTURE SYSTEM ──────────────────────────────────

model Enquiry {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  phone       String
  serviceName String?
  message     String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// ─── KNOWLEDGE BASE FOR CONTEXTUAL AI ASSISTANT ──────────────────────────────

model KnowledgeBase {
  id          String   @id @default(cuid())
  businessId  String
  category    String
  question    String
  answer      String
  tags        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category])
}

// ─── LIVE WHATSAPP CONVERSATIONS & HUMAN HANDOFF ──────────────────────────────

model Conversation {
  id              String    @id @default(cuid())
  businessId      String
  customerId      String?
  customerPhone   String
  customerName    String?
  language        String    @default("hinglish")
  isBotPaused     Boolean   @default(false)
  pausedUntil     DateTime?
  lastMessageAt   DateTime  @default(now())
  unreadCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]

  @@unique([businessId, customerPhone])
  @@index([businessId, isBotPaused])
}

model ChatMessage {
  id              String       @id @default(cuid())
  conversationId  String
  sender          String
  text            String
  externalId      String?
  status          String       @default("DELIVERED")
  timestamp       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
}

// ─── ZERO-COST AI KEY POOLS & ROTATION TELEMETRY ─────────────────────────────

model AIKeyPool {
  id            String    @id @default(cuid())
  provider      String
  maskedKey     String
  encryptedKey  String
  isActive      Boolean   @default(true)
  cooldownUntil DateTime?
  totalCalls    Int       @default(0)
  failedCalls   Int       @default(0)
  createdAt     DateTime  @default(now())
}
