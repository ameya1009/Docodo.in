generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTHENTICATION & ACCESS CONTROL ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for credentials login
  role          String    @default("OWNER") // OWNER | MANAGER | STAFF
  plan          String    @default("PILOT") // PILOT | STARTER | GROWTH | CONCIERGE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  businesses    Business[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── CORE BUSINESS METADATA ──────────────────────────────────────────────────

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  industry    String
  tagline     String?
  description String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  website     String?
  logo        String?  // Cloud storage URL
  coverImage  String?  // Cloud storage URL
  
  // Theme Design Tokens
  style       String   @default("modern")
  primaryColor String  @default("#C8F135")
  accentColor  String  @default("#00FFAA")
  fontHeading  String  @default("Unbounded")
  fontBody     String  @default("DM Sans")
  darkMode     Boolean @default(true)
  
  // Social Connectivity
  instagram   String?
  facebook    String?
  youtube     String?
  twitter     String?
  whatsapp    String?
  
  // Platform Configuration
  isPublished Boolean  @default(true)
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  
  // SEO Optimization
  seoTitle    String?
  seoDesc     String?
  websiteConfig String? @default("{\"hero\":true,\"services\":true,\"about\":true,\"gallery\":true,\"testimonials\":true,\"faq\":false,\"contact\":true,\"booking_cta\":true}")
  
  // Onboarding & Discovery Telemetry
  onboardingStep     Int       @default(4)
  onboardingComplete Boolean   @default(true)
  onboardingStartedAt DateTime?
  onboardingCompletedAt DateTime?
  setupTimeMinutes   Int?
  discoveryQuery     String?
  discoveredProfile  String?
  activationScore    Int       @default(20)
  activatedAt        DateTime?
  timeToFirstBooking Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  workingHours WorkingHours[]
  services     Service[]
  staff        Staff[]
  bookings     Booking[]
  customers    Customer[]
  enquiries    Enquiry[]
  aiContents   AIContent[]
  whatsappLogs WhatsAppLog[]
  codLedgers   CODLedger[]
  ndrDisputes  NDRDispute[]
  knowledgeBases KnowledgeBase[]
  conversations  Conversation[]

  // Real Subscriptions, Entitlements & Provisioning
  subscriptions       Subscription[]
  entitlements        BusinessEntitlement[]
  usageRecords        UsageRecord[]
  conciergeOrders     ConciergeOrder[]
}

// ─── SUBSCRIPTIONS & ENTITLEMENTS LEDGER ─────────────────────────────────────

model Subscription {
  id                     String    @id @default(cuid())
  businessId             String
  planId                 String    // pilot | starter | growth | setup-service
  status                 String    @default("ACTIVE") // TRIAL | ACTIVE | PAST_DUE | CANCELLED | EXPIRED | PAYMENT_FAILED
  provider               String    @default("SYSTEM") // RAZORPAY | SYSTEM | CONCIERGE
  providerSubscriptionId String?
  currentPeriodStart     DateTime  @default(now())
  currentPeriodEnd       DateTime
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

model Plan {
  id              String        @id
  name            String
  price           Float
  billingInterval String        // FOREVER | MONTHLY | ONE_TIME
  active          Boolean       @default(true)
  features        PlanFeature[]
}

model PlanFeature {
  id         String  @id @default(cuid())
  planId     String
  featureKey String
  value      String  // "true", "false", "50", "UNLIMITED"

  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model BusinessEntitlement {
  id         String    @id @default(cuid())
  businessId String
  featureKey String
  value      String
  source     String    @default("PLAN") // PLAN | CONCIERGE | MANUAL_OVERRIDE | TRIAL
  startsAt   DateTime  @default(now())
  expiresAt  DateTime?

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureKey])
  @@index([businessId])
}

model UsageRecord {
  id          String   @id @default(cuid())
  businessId  String
  metric      String   // BOOKINGS_COUNT
  periodStart DateTime
  periodEnd   DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, metric, periodStart, periodEnd])
  @@index([businessId, metric])
}

model ConciergeOrder {
  id                 String    @id @default(cuid())
  businessId         String
  status             String    @default("PAYMENT_RECEIVED") // PAYMENT_RECEIVED | ONBOARDING_PENDING | SPECIALIST_ASSIGNED | BUSINESS_DETAILS_COLLECTED | SERVICES_UPLOADED | HOURS_CONFIGURED | BOOKING_PAGE_READY | QR_READY | WHATSAPP_OPTIMIZED | TRAINING_COMPLETED | COMPLETED
  assignedSpecialist String?   @default("Ameya Kshirsagar")
  onboardingStatus   String?   @default("SPECIALIST_ASSIGNED")
  purchasedAt        DateTime  @default(now())
  growthStart        DateTime?
  growthEnd          DateTime?
  razorpayPaymentId  String?
  razorpayOrderId    String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  payload     String   // JSON payload string
  status      String   @default("PROCESSED") // PROCESSED | FAILED
  processedAt DateTime @default(now())

  @@index([eventId])
}

// ─── CATALOG & HUMAN RESOURCES ───────────────────────────────────────────────

model WorkingHours {
  id         String   @id @default(cuid())
  businessId String
  day        String   // MON | TUE | WED | THU | FRI | SAT | SUN
  isOpen     Boolean  @default(true)
  openTime   String   @default("09:00")
  closeTime  String   @default("19:00")
  breakStart String?
  breakEnd   String?
  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  duration    Int      @default(60)
  price       Float    @default(999)
  currency    String   @default("INR")
  isActive    Boolean  @default(true)
  color       String?  
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([businessId])
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  name       String
  role       String?  @default("Specialist")
  email      String?
  phone      String?
  avatar     String?
  bio        String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([businessId])
}

// ─── BOOKINGS & TRANSACTION LEDGER ───────────────────────────────────────────

model Booking {
  id           String   @id @default(cuid())
  businessId   String
  serviceId    String?
  staffId      String?
  customerId   String?
  
  customerName  String
  customerEmail String?
  customerPhone String
  
  date          String   // YYYY-MM-DD
  startTime     String   // HH:MM
  endTime       String   
  duration      Int      
  
  status        String   @default("CONFIRMED") // CONFIRMED | PENDING | COMPLETED | CANCELLED | NO_SHOW | NDR_HOLD
  notes         String?
  internalNotes String?
  price         Float    @default(0)
  paidAmount    Float    @default(0)
  paymentStatus String   @default("UNPAID") // UNPAID | PARTIAL | PAID | COD_VERIFYING
  paymentMethod String?  @default("UPI")
  
  reminderSent  Boolean  @default(false)
  reviewSent    Boolean  @default(false)
  
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service       Service?  @relation(fields: [serviceId], references: [id])
  staff         Staff?    @relation(fields: [staffId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  ndrDispute    NDRDispute?

  @@index([businessId, date, status])
  @@index([customerId])
  @@index([businessId, createdAt])
}

// ─── CRM (CUSTOMER RELATIONSHIP MANAGEMENT) ──────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  email         String?
  phone         String
  avatar        String?
  notes         String?
  tags          String?
  lifetimeValue Float    @default(0)
  visitCount    Int      @default(0)
  source        String?  @default("WHATSAPP")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@unique([businessId, phone])
  @@index([businessId])
}

// ─── AI ENGINE STORAGE & HISTORY ─────────────────────────────────────────────

model AIContent {
  id         String   @id @default(cuid())
  businessId String
  type       String
  prompt     String?
  content    String
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── WHATSAPP AUTOMATION ENGINE LOGS ─────────────────────────────────────────

model WhatsAppLog {
  id          String   @id @default(cuid())
  businessId  String
  recipient   String
  messageType String
  content     String
  status      String   @default("DELIVERED")
  externalId  String?
  timestamp   DateTime @default(now())
  
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── CASH ON DELIVERY & PAYMENT RECONCILIATION LEDGER ────────────────────────

model CODLedger {
  id            String   @id @default(cuid())
  businessId    String
  bookingId     String?  
  amount        Float
  status        String   @default("PENDING_COLLECTION")
  collectorName String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── NON-DELIVERY REPORT (NDR) & DISPUTE DEFENSE SYSTEM ──────────────────────

model NDRDispute {
  id            String   @id @default(cuid())
  businessId    String
  bookingId     String   @unique
  reason        String
  aiResolution  String?
  status        String   @default("UNDER_AI_REVIEW")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── CUSTOMER ENQUIRY & LEAD CAPTURE SYSTEM ──────────────────────────────────

model Enquiry {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  phone       String
  serviceName String?
  message     String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// ─── KNOWLEDGE BASE FOR CONTEXTUAL AI ASSISTANT ──────────────────────────────

model KnowledgeBase {
  id          String   @id @default(cuid())
  businessId  String
  category    String
  question    String
  answer      String
  tags        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category])
}

// ─── LIVE WHATSAPP CONVERSATIONS & HUMAN HANDOFF ──────────────────────────────

model Conversation {
  id              String    @id @default(cuid())
  businessId      String
  customerId      String?
  customerPhone   String
  customerName    String?
  language        String    @default("hinglish")
  isBotPaused     Boolean   @default(false)
  pausedUntil     DateTime?
  lastMessageAt   DateTime  @default(now())
  unreadCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]

  @@unique([businessId, customerPhone])
  @@index([businessId, isBotPaused])
}

model ChatMessage {
  id              String       @id @default(cuid())
  conversationId  String
  sender          String
  text            String
  externalId      String?
  status          String       @default("DELIVERED")
  timestamp       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
}

// ─── ZERO-COST AI KEY POOLS & ROTATION TELEMETRY ─────────────────────────────

model AIKeyPool {
  id            String    @id @default(cuid())
  provider      String
  maskedKey     String
  encryptedKey  String
  isActive      Boolean   @default(true)
  cooldownUntil DateTime?
  totalCalls    Int       @default(0)
  failedCalls   Int       @default(0)
  createdAt     DateTime  @default(now())
}

// ─── OMNICHANNEL GROWTH OS & CUSTOMER ACQUISITION PLATFORM ───────────────────

model LeadEntity {
  id                 String              @id @default(cuid())
  businessId         String?             // Optional tenant business context
  canonicalName      String
  normalizedDomain   String?
  normalizedPhone    String?
  city               String?
  state              String?
  country            String              @default("IN")
  address            String?
  industry           String?
  category           String?
  icpScore           Int                 @default(0) // 0 - 100
  crmStage           String              @default("discovered") // discovered | researched | qualified | high_intent | outreach_ready | contacted | replied | interested | demo | proposal | negotiation | won | lost | nurture | suppressed
  confidenceScore    Float               @default(1.0)
  primarySource      String              @default("google_places")
  isVerified         Boolean             @default(false)
  notes              String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  identities         SocialIdentity[]
  opportunities      OpportunityRecord[]
  outreachSequences  OutreachSequence[]
  attributionEvents  AttributionEvent[]

  @@index([canonicalName])
  @@index([crmStage])
  @@index([normalizedDomain])
  @@index([normalizedPhone])
}

model SocialIdentity {
  id              String      @id @default(cuid())
  leadEntityId    String
  platform        String      // google_places | website | linkedin | instagram | facebook | x | reddit | youtube | pinterest | directory
  platformUserId  String?     // Unique platform ID or handle
  profileUrl      String?
  displayName     String?
  handle          String?
  followerCount   Int?        @default(0)
  reviewCount     Int?        @default(0)
  rating          Float?      @default(0.0)
  isVerified      Boolean     @default(false)
  lastActivityAt  DateTime?
  sourcePayload   Json?
  confidence      Float       @default(1.0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  leadEntity      LeadEntity  @relation(fields: [leadEntityId], references: [id], onDelete: Cascade)

  @@index([leadEntityId, platform])
  @@index([platform, platformUserId])
}

model LeadGraphEdge {
  id              String      @id @default(cuid())
  sourceType      String      // business | website | social_profile | contact | campaign | touchpoint
  sourceId        String
  targetType      String      // business | website | social_profile | contact | campaign | touchpoint
  targetId        String
  relationType    String      // OWNS | ASSOCIATED_WITH | MENTIONS | INTERACTED_WITH | REFERRED_BY
  confidence      Float       @default(1.0)
  metadata        Json?
  createdAt       DateTime    @default(now())

  @@index([sourceId, sourceType])
  @@index([targetId, targetType])
  @@index([relationType])
}

model OpportunityRecord {
  id                  String      @id @default(cuid())
  leadEntityId        String
  problem             String      // e.g. "poor_website", "no_booking_funnel", "lost_whatsapp_leads", "low_google_reviews"
  evidence            String      // Extracted observations
  source              String      // instagram | website | google_places | reddit | etc.
  recommendedSolution String      // High level strategy
  recommendedProduct  String      // Docodo AI Storefront | WhatsApp Receptionist | Review Engine | Booking Engine
  confidence          Float       @default(0.9)
  status              String      @default("OPEN") // OPEN | PITCHED | ACCEPTED | REJECTED
  metadata            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  leadEntity          LeadEntity  @relation(fields: [leadEntityId], references: [id], onDelete: Cascade)

  @@index([leadEntityId, problem])
  @@index([recommendedProduct])
}

model SocialListeningSignal {
  id              String      @id @default(cuid())
  platform        String      // x | reddit | instagram | facebook | linkedin | youtube
  authorHandle    String?
  authorName      String?
  content         String
  postUrl         String?
  intentClass     String      // lead_gen | website_conversion | local_seo | crm_followup | whatsapp_automation | general_inquiry
  entityType      String      @default("potential_customer") // potential_customer | existing_customer | competitor | industry_discussion | general_user | irrelevant | unknown
  sentiment       String      @default("neutral") // positive | negative | neutral
  isLead          Boolean     @default(false)
  leadEntityId    String?
  metadata        Json?
  capturedAt      DateTime    @default(now())

  @@index([platform, intentClass])
  @@index([isLead, entityType])
}

model ContentAsset {
  id                  String      @id @default(cuid())
  businessId          String?
  topic               String
  pillar              String      // e.g. "AI for local business", "Local SEO", "WhatsApp automation"
  format              String      // linkedin_post | instagram_carousel | instagram_reel | facebook_post | x_thread | youtube_short | youtube_script | pinterest_pin | blog_article | newsletter | ad_variation
  platform            String      // linkedin | instagram | facebook | x | youtube | pinterest | blog | email
  hook                String?
  script              String?
  copy                String
  imageBrief          String?
  videoBrief          String?
  thumbnailPrompt     String?
  caption             String?
  cta                 String?
  hashtags            String[]    @default([])
  status              String      @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | SCHEDULED | PUBLISHED | REJECTED
  scheduledAt         DateTime?
  publishedAt         DateTime?
  publishedUrl        String?
  analytics           Json?       // impressions, likes, shares, comments, clicks
  metadata            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([platform, status])
  @@index([pillar])
  @@index([scheduledAt])
}

model AdCampaign {
  id                  String      @id @default(cuid())
  businessId          String?
  name                String
  platform            String      // google_ads | meta_ads | linkedin_ads | x_ads | pinterest_ads
  objective           String      // LEAD_GENERATION | TRAFFIC | CONVERSIONS | BRAND_AWARENESS
  targetAudience      Json?
  adCopy              String
  creativeUrl         String?
  landingPageUrl      String?
  dailyBudget         Float       @default(500.0)
  monthlyBudgetLimit  Float       @default(15000.0)
  currentSpend        Float       @default(0.0)
  status              String      @default("DRAFT") // DRAFT | PENDING_APPROVAL | ACTIVE | PAUSED | COMPLETED | REJECTED
  roas                Float       @default(0.0)
  cpl                 Float       @default(0.0)
  leadsGenerated      Int         @default(0)
  impressions         Int         @default(0)
  clicks              Int         @default(0)
  approvalStatus      String      @default("REQUIRES_APPROVAL") // REQUIRES_APPROVAL | APPROVED | REJECTED
  approvedBy          String?
  approvedAt          DateTime?
  metadata            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([platform, status])
  @@index([approvalStatus])
}

model OutreachSequence {
  id                  String      @id @default(cuid())
  leadEntityId        String
  channel             String      // email | whatsapp | linkedin | instagram_dm | x_dm
  step                Int         @default(1)
  templateId          String?
  draftSubject        String?
  draftBody           String
  evidenceCitations   String[]    @default([])
  status              String      @default("DRAFT") // DRAFT | APPROVAL_REQUIRED | APPROVED | QUEUED | SENT | OPENED | REPLIED | OPT_OUT | FAILED
  recipientAddress    String      // email address, phone number, or handle
  scheduledAt         DateTime?
  sentAt              DateTime?
  openedAt            DateTime?
  repliedAt           DateTime?
  optOut              Boolean     @default(false)
  errorMessage        String?
  metadata            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  leadEntity          LeadEntity  @relation(fields: [leadEntityId], references: [id], onDelete: Cascade)

  @@index([leadEntityId, channel])
  @@index([status])
}

model AttributionEvent {
  id                  String      @id @default(cuid())
  leadEntityId        String
  touchpointType      String      // first_touch | middle_touch | last_touch | conversion
  platform            String      // google | instagram | facebook | linkedin | x | reddit | direct | referral
  campaignId          String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmContent          String?
  conversionMilestone String      // discovered | qualified | demo_booked | won
  value               Float       @default(0.0)
  timestamp           DateTime    @default(now())

  leadEntity          LeadEntity  @relation(fields: [leadEntityId], references: [id], onDelete: Cascade)

  @@index([leadEntityId, touchpointType])
  @@index([platform, utmCampaign])
}

model SupervisorRun {
  id                  String      @id @default(cuid())
  businessId          String?
  objective           String
  status              String      @default("RUNNING") // RUNNING | PAUSED_FOR_APPROVAL | COMPLETED | FAILED
  currentStep         String      @default("discovery")
  stepHistory         Json?       // List of completed step records
  discoveredCount     Int         @default(0)
  qualifiedCount      Int         @default(0)
  draftsCount         Int         @default(0)
  campaignsCount      Int         @default(0)
  budgetSpent         Float       @default(0.0)
  budgetLimit         Float       @default(0.0)
  logEntries          Json?       // Structured execution logs
  startedAt           DateTime    @default(now())
  completedAt         DateTime?

  @@index([status])
  @@index([startedAt])
}
