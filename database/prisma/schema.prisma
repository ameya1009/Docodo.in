generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTHENTICATION & ACCESS CONTROL ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for credentials login
  role          String    @default("OWNER") // OWNER | MANAGER | STAFF
  plan          String    @default("STARTER") // FREE | STARTER | PRO | ENTERPRISE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  businesses    Business[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── CORE BUSINESS METADATA ──────────────────────────────────────────────────

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  industry    String
  tagline     String?
  description String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  website     String?
  logo        String?  // Cloud storage URL
  coverImage  String?  // Cloud storage URL
  
  // Theme Design Tokens
  style       String   @default("modern") // modern|luxury|minimal|elegant|premium|classic
  primaryColor String  @default("#C8F135") // Signature Docodo Lime
  accentColor  String  @default("#00FFAA") // Teal secondary
  fontHeading  String  @default("Unbounded")
  fontBody     String  @default("DM Sans")
  darkMode     Boolean @default(true)
  
  // Social Connectivity
  instagram   String?
  facebook    String?
  youtube     String?
  twitter     String?
  whatsapp    String?
  
  // Platform Configuration
  isPublished Boolean  @default(true)
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  
  // SEO Optimization
  seoTitle    String?
  seoDesc     String?
  websiteConfig String? @default("{\"hero\":true,\"services\":true,\"about\":true,\"gallery\":true,\"testimonials\":true,\"faq\":false,\"contact\":true,\"booking_cta\":true}")
  
  // Onboarding & Business Discovery Telemetry
  onboardingStep     Int      @default(4)
  onboardingComplete Boolean  @default(true)
  discoveryQuery     String?
  discoveredProfile  String?  // JSON string of AI discovered/synthesized business details
  activationScore    Int      @default(20) // Starts at 20% upon website generation
  activatedAt        DateTime?
  timeToFirstBooking Int?     // Duration in seconds from account creation to first booking

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  workingHours WorkingHours[]
  services     Service[]
  staff        Staff[]
  bookings     Booking[]
  customers    Customer[]
  aiContents   AIContent[]
  whatsappLogs WhatsAppLog[]
  codLedgers   CODLedger[]
  ndrDisputes  NDRDispute[]
}

model WorkingHours {
  id         String   @id @default(cuid())
  businessId String
  day        String   // MON | TUE | WED | THU | FRI | SAT | SUN
  isOpen     Boolean  @default(true)
  openTime   String   @default("09:00")
  closeTime  String   @default("19:00")
  breakStart String?
  breakEnd   String?
  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
}

// ─── CATALOG & HUMAN RESOURCES ───────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  duration    Int      @default(60) // in minutes
  price       Float    @default(999)
  currency    String   @default("INR")
  isActive    Boolean  @default(true)
  color       String?  
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings    Booking[]
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  name       String
  role       String?  @default("Specialist")
  email      String?
  phone      String?
  avatar     String?
  bio        String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]
}

// ─── BOOKINGS & TRANSACTION LEDGER ───────────────────────────────────────────

model Booking {
  id           String   @id @default(cuid())
  businessId   String
  serviceId    String?
  staffId      String?
  customerId   String?
  
  customerName  String
  customerEmail String?
  customerPhone String
  
  date          String   // YYYY-MM-DD
  startTime     String   // HH:MM (24hr format)
  endTime       String   
  duration      Int      
  
  status        String   @default("CONFIRMED") // CONFIRMED | PENDING | COMPLETED | CANCELLED | NO_SHOW | NDR_HOLD
  notes         String?
  internalNotes String?
  price         Float    @default(0)
  paidAmount    Float    @default(0)
  paymentStatus String   @default("UNPAID") // UNPAID | PARTIAL | PAID | COD_VERIFYING
  paymentMethod String?  @default("UPI")    // UPI | CASH_ON_DELIVERY | CARDS | NETBANKING
  
  reminderSent  Boolean  @default(false)
  reviewSent    Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service       Service?  @relation(fields: [serviceId], references: [id])
  staff         Staff?    @relation(fields: [staffId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  ndrDispute    NDRDispute?
}

// ─── CRM (CUSTOMER RELATIONSHIP MANAGEMENT) ──────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  email         String?
  phone         String
  avatar        String?
  notes         String?
  tags          String?  // Stored as JSON string array e.g. '["VIP", "Loyal"]'
  lifetimeValue Float    @default(0)
  visitCount    Int      @default(0)
  source        String?  @default("WHATSAPP") // BOOKING | WHATSAPP | REFERRAL | WALK_IN | INSTAGRAM
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@unique([businessId, phone])
}

// ─── AI ENGINE STORAGE & HISTORY ─────────────────────────────────────────────

model AIContent {
  id         String   @id @default(cuid())
  businessId String
  type       String   // DESCRIPTION | SEO | INSTAGRAM | WHATSAPP_CAMPAIGN | BLOG | FAQ | REVIEW_REPLY
  prompt     String?
  content    String   // Generated copy text
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── WHATSAPP AUTOMATION ENGINE LOGS ─────────────────────────────────────────

model WhatsAppLog {
  id          String   @id @default(cuid())
  businessId  String
  recipient   String   // Phone number
  messageType String   // BOOKING_CONFIRM | REMINDER_24HR | REVIEW_REQUEST | NDR_VERIFICATION | BROADCAST
  content     String
  status      String   @default("DELIVERED") // QUEUED | SENT | DELIVERED | READ | FAILED
  externalId  String?  // Cloud API Message ID
  timestamp   DateTime @default(now())
  
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── CASH ON DELIVERY & PAYMENT RECONCILIATION LEDGER ────────────────────────

model CODLedger {
  id            String   @id @default(cuid())
  businessId    String
  bookingId     String?  
  amount        Float
  status        String   @default("PENDING_COLLECTION") // PENDING_COLLECTION | COLLECTED | DEPOSITED | DISPUTED | FRAUD_BLOCKED
  collectorName String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── NON-DELIVERY REPORT (NDR) & DISPUTE DEFENSE SYSTEM ──────────────────────

model NDRDispute {
  id            String   @id @default(cuid())
  businessId    String
  bookingId     String   @unique
  reason        String   // CUSTOMER_UNREACHABLE | FAKE_PHONE | WRONG_ADDRESS | RESCHEDULE_REQUESTED
  aiResolution  String?  // AI action taken e.g. "Sent interactive WhatsApp confirmation button"
  status        String   @default("UNDER_AI_REVIEW") // UNDER_AI_REVIEW | RESOLVED_CONFIRMED | RESOLVED_CANCELLED | ESCALATED_HUMAN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
